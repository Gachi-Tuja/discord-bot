# 필수
DISCORD_TOKEN=
DISCORD_GUILD_ID=
IPO_CHANNEL_ID=
RESULT_CHANNEL_ID=
ANTHROPIC_API_KEY=
DART_API_KEY=
KRX_AUTH_KEY=

# 선택. 주석을 풀고 값을 바꾼다(아래 값이 기본값). 값 뒤에 주석을 달지 않는다.
# 공시 요약 모델
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5
# 예측 파싱 모델
# ANTHROPIC_PARSE_MODEL=claude-sonnet-4-5
# KRX API 기본 주소
# KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
# SQLite 파일
# DB_PATH=./data/ipobot.sqlite3
# 주간 게시 요일
# WEEKLY_POST_WEEKDAY=FRI
# 주간 게시 시각(KST)
# WEEKLY_POST_TIME=18:00
# 주간 게시 재시도 허용 시간
# WEEKLY_POST_GRACE_HOURS=6
# 주간 게시 실패 후 재시도 간격. WEEKLY_POST_GRACE_HOURS*60보다 작아야 함
# WEEKLY_RETRY_BACKOFF_MINUTES=15
# 다이제스트 대상 기간(일)
# IPO_RANGE_DAYS=7
# 예측 기준일 탐색 범위(거래일)
# BASE_LOOKBACK_TRADING_DAYS=3
# 판정 첫 시도 시각(KST). KRX_POLL_DEADLINE보다 일러야 함
# JUDGE_TIME=09:00
# KRX 미공개 시 재조회 간격(분)
# KRX_POLL_INTERVAL_MINUTES=30
# 당일 폴링 마감(KST)
# KRX_POLL_DEADLINE=15:00
# 무거래·행 없음 거래일 상한(N). 1 이상
# JUDGE_MAX_ATTEMPTS=5
# KRX 조회 불가 관측 영업일 상한. 1 이상
# JUDGE_STALE_BUSINESS_DAYS=10
# 요약 실패 재시도 일수
# SUMMARY_RETRY_DAYS=3
# 스케줄러 tick 간격(초)
# SCHEDULER_TICK_SECONDS=60
# 로그 레벨
# LOG_LEVEL=INFO
